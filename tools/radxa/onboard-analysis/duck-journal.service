[Unit]
Description=Microduck 系统日志实时抄写到卡上（每秒写盘，拔电不丢）
After=systemd-journald.service
[Service]
Type=simple
User=duck
ExecStart=/bin/bash -c "exec python3 /home/duck/tools/duck_journal.py /home/duck/r17/rec/journal-$(date +%%Y%%m%%d-%%H%%M%%S)-b$(cut -c1-6 /proc/sys/kernel/random/boot_id).log"
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
